# Copy to .env and fill in real values. Never commit real secrets.

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pharmacy?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/pharmacy"

# NextAuth — generate the secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Seed passwords (used by prisma/seed.mjs; defaults are for local demo only)
SEED_ADMIN_PASSWORD=""
SEED_SELLER_PASSWORD=""
